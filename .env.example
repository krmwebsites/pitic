# Avalik aadress, mida kasutatakse metaandmetes (Open Graph, sitemap).
NEXT_PUBLIC_SITE_URL=https://pitic.ee

# --- SimplyBook.me broneerimissüsteem ---------------------------------------
# Ettevõtte broneerimislehe aadress SimplyBook.me-s, nt https://pitic.simplybook.it
# Kuni see on tühi, näitab veebileht broneerimiskalendri asemel kontaktivarianti.
NEXT_PUBLIC_SIMPLYBOOK_URL=

# Iga ruumi teenuse ID SimplyBook.me-s (Manage -> Services -> teenuse lingis olev number).
# Valikuline: kui ID on olemas, eelvalib vidin ruumi lehel õige ruumi.
NEXT_PUBLIC_SIMPLYBOOK_SERVICE_JOUSAAL=
NEXT_PUBLIC_SIMPLYBOOK_SERVICE_NOUPIDAMISTE_RUUM=
NEXT_PUBLIC_SIMPLYBOOK_SERVICE_SUURSAAL=

# --- SimplyBook.me API (ainult server, ei jõua brauserisse) --------------------
# Ettevõtte login-nimi (aadressi algus, nt pitictest) ja avaliku API võti:
# SimplyBook haldus -> Custom Features -> API -> Enable -> API key.
SIMPLYBOOK_COMPANY=
SIMPLYBOOK_API_KEY=

# Arendusrežiim ilma kontota: näitab näidisaegu ja ei loo päris broneeringuid.
# Ära kunagi lülita sisse avalikus keskkonnas.
SIMPLYBOOK_MOCK=false
